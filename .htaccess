# Kaizen Karate - Catch-All Redirect to Homepage
# This will redirect any URL that doesn't match an existing file or directory to the homepage

RewriteEngine On
# Clean URL for policies page
RewriteRule ^policies/?$ pages/policies.php [L]
RewriteRule ^faq/?$ pages/faq.php [L]
RewriteRule ^student-handbook/?$ pages/student-handbook.php [L]
RewriteRule ^kaizen-dojo/?$ pages/kaizen-dojo.php [L]
RewriteRule ^about/?$ pages/about.php [L]
RewriteRule ^summer-camp/?$ pages/summer-camp.php [L]
RewriteRule ^after-school/?$ pages/after-school.php [L]
RewriteRule ^weekend-evening/?$ pages/weekend-evening.php [L]
RewriteRule ^online-store/?$ pages/online-store.php [L]
RewriteRule ^belt-exam/?$ pages/belt-exam.php [L]
RewriteRule ^kaizen-kenpo/?$ pages/kaizen-kenpo.php [L]
RewriteRule ^testing-tips/?$ pages/testing-tips.php [L]
RewriteRule ^video-instructions/?$ belts/video-instructions.php [L]
RewriteRule ^green-belt/?$ belts/green-belt.php [L]
RewriteRule ^purple-belt/?$ belts/purple-belt.php [L]
RewriteRule ^blue-belt/?$ belts/blue-belt.php [L]
RewriteRule ^brown-belt/?$ belts/brown-belt.php [L]
RewriteRule ^brown-stripe/?$ belts/brown-stripe.php [L]
RewriteRule ^red-belt/?$ belts/red-belt.php [L]
RewriteRule ^red-stripe/?$ belts/red-stripe.php [L]
RewriteRule ^nyc/?$ pages/nyc.php [L]

# Files relocated into subdirectories keep their original URLs.
RewriteRule ^about\.php$ pages/about.php [L]
RewriteRule ^after\-school\.php$ pages/after-school.php [L]
RewriteRule ^belt\-exam\.php$ pages/belt-exam.php [L]
RewriteRule ^demo\-schedule\.php$ pages/demo-schedule.php [L]
RewriteRule ^faq\.php$ pages/faq.php [L]
RewriteRule ^gallery\.php$ pages/gallery.php [L]
RewriteRule ^kaizen\-dojo\.php$ pages/kaizen-dojo.php [L]
RewriteRule ^kaizen\-kenpo\.php$ pages/kaizen-kenpo.php [L]
RewriteRule ^nyc\.php$ pages/nyc.php [L]
RewriteRule ^online\-store\.php$ pages/online-store.php [L]
RewriteRule ^policies\.php$ pages/policies.php [L]
RewriteRule ^student\-handbook\.php$ pages/student-handbook.php [L]
RewriteRule ^summer\-camp\.php$ pages/summer-camp.php [L]
RewriteRule ^testing\-tips\.php$ pages/testing-tips.php [L]
RewriteRule ^weekend\-evening\.php$ pages/weekend-evening.php [L]
RewriteRule ^belt\-script\-page\.php$ belts/belt-script-page.php [L]
RewriteRule ^blue\-belt\.php$ belts/blue-belt.php [L]
RewriteRule ^brown\-belt\.php$ belts/brown-belt.php [L]
RewriteRule ^brown\-stripe\.php$ belts/brown-stripe.php [L]
RewriteRule ^green\-belt\.php$ belts/green-belt.php [L]
RewriteRule ^purple\-belt\.php$ belts/purple-belt.php [L]
RewriteRule ^red\-belt\.php$ belts/red-belt.php [L]
RewriteRule ^red\-stripe\.php$ belts/red-stripe.php [L]
RewriteRule ^video\-instructions\.php$ belts/video-instructions.php [L]
RewriteRule ^chatbot\-business\-chat\.php$ chatbot-business/chatbot-business-chat.php [L]
RewriteRule ^chatbot\-business\-review\.php$ chatbot-business/chatbot-business-review.php [L]
RewriteRule ^chatbot\-business\-setup\.php$ chatbot-business/chatbot-business-setup.php [L]
RewriteRule ^chatbot\-business\.php$ chatbot-business/chatbot-business.php [L]

# Handle kaizenfitnessusa.com domain redirects
RewriteCond %{HTTP_HOST} ^(www\.)?kaizenfitnessusa\.com [NC]
RewriteRule ^summer-camp-2025/?$ https://kaizenkarateusa.com/#summer-camp [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?kaizenfitnessusa\.com [NC]
RewriteRule ^about/?$ https://kaizenkarateusa.com/#about [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?kaizenfitnessusa\.com [NC]
RewriteRule ^classes/?$ https://kaizenkarateusa.com/#weekend-evening [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?kaizenfitnessusa\.com [NC]
RewriteRule ^contact/?$ https://kaizenkarateusa.com/#contact [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?kaizenfitnessusa\.com [NC]
RewriteRule ^(.*)$ https://kaizenkarateusa.com/ [R=301,L]

# Redirect everything else to homepage (internal rewrite, no visible redirect)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|ico|pdf|svg|woff|woff2|ttf|eot|php)$ [NC]
RewriteRule ^(.*)$ index.php [L]

# Optional: Force HTTPS (uncomment if you have SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Optional: Force www (uncomment if you want to force www)
# RewriteCond %{HTTP_HOST} !^www\.
# RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301] 
